@model List<PlayerCards.Models.PlayerCategory>

@{
    ViewData["Title"] = "Manage Categories";
}

<style>
    /* Add the FontAwesome link here, escaped for Razor */
    @@import url('https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css');

    body {
        background-color: #f7f8fa;
        font-family: 'Segoe UI', sans-serif;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
    }

        .page-header h2 {
            font-weight: 600;
            color: #333;
            margin: 0;
        }

    .create-btn {
        background-color: #007bff;
        color: white;
        padding: 10px 18px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 500;
        transition: all 0.2s ease;
    }

        .create-btn:hover {
            background-color: #0056b3;
            text-decoration: none;
        }

    .category-card {
        background-color: #fff;
        border-radius: 12px;
        box-shadow: 0 3px 8px rgba(0, 0, 0, 0.08);
        padding: 20px;
        /* Required for absolute positioning of the action icon */
        position: relative;
        display: flex;
        justify-content: space-between;
        align-items: center;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .category-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 5px 12px rgba(0, 0, 0, 0.1);
        }

    .category-name {
        font-size: 1.1rem;
        font-weight: 500;
        color: #333;
        /* Ensure name doesn't overlap the icon */
        padding-right: 35px;
    }

    .category-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 20px;
    }

    /* --- DELETE ACTION STYLES --- */
    .category-actions {
        /* Move delete icon to the top right corner */
        position: absolute;
        top: 10px;
        right: 10px;
        z-index: 5;
    }

        .category-actions .btn-icon {
            background: none;
            border: none;
            padding: 5px;
            cursor: pointer;
            line-height: 1;
        }

        .category-actions .delete-icon {
            color: #a0a0a0; /* Default gray */
            font-size: 1.1rem;
            transition: color 0.2s ease, transform 0.2s ease;
        }

            .category-actions .delete-icon:hover {
                color: #dc3545; /* Red on hover */
                transform: scale(1.1);
            }
        /* Ensure the delete button is visually separate from the form itself */
        .category-actions .delete-form {
            margin: 0;
            padding: 0;
        }

</style>

<div class="container py-4">
    <div class="page-header">
        <h2>Player Categories</h2>
        <a asp-action="Create" class="create-btn"> <i class="fa-solid fa-plus"></i> Create New Category</a>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="category-grid">
            @foreach (var category in Model)
            {
                <div class="category-card">
                    <div class="category-name">@category.Name</div>

                    <div class="category-actions">

                        @* Form for immediate deletion *@
                        <form asp-action="Delete" asp-route-id="@category.Id" method="post"
                              class="delete-form" data-name="@category.Name">

                            @Html.AntiForgeryToken()

                            <button type="submit" class="btn-icon delete-icon" title="Delete @category.Name">
                                <i class="fa-solid fa-trash-can"></i>
                            </button>
                        </form>

                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <p class="text-muted mt-4">No categories have been added yet.</p>
    }
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {

            // Listen for submission on any form with the class 'delete-form'
            const deleteForms = document.querySelectorAll('.delete-form');

            deleteForms.forEach(form => {
                form.addEventListener('submit', function (e) {
                    const categoryName = this.getAttribute('data-name');

                    // Show a confirmation dialog
                    const confirmation = confirm(`Are you sure you want to permanently delete the category: "${categoryName}"? This action cannot be undone.`);

                    if (!confirmation) {
                        e.preventDefault(); // Stop the form submission if the user clicks 'Cancel'
                    }
                });
            });
        });
    </script>
}