@section Scripts {
    <script>
        // Global function for carousel scrolling
        function scrollCarousel(direction) {
            const carousel = document.getElementById('featuredCarousel');

            if (carousel) {
                const firstCard = carousel.querySelector('.player-card');
                let scrollAmount = carousel.clientWidth / 4; // Default scroll distance

                if (firstCard) {
                     const cardWidth = firstCard.offsetWidth;
                     const gap = 30; // Matches your CSS gap
                     scrollAmount = cardWidth + gap;
                }

                const newScrollLeft = carousel.scrollLeft + (direction * scrollAmount);

                carousel.scrollTo({
                    left: newScrollLeft,
                    behavior: 'smooth'
                });
            }
        }

        // Wait for the full page to load before attaching event listeners
        document.addEventListener('DOMContentLoaded', function () {

            const container = document.getElementById('featuredCarousel');

            // 🎯 CRITICAL FIX: Change listener from 'submit' (which only fires on <form>) to 'click'
            // and use e.target.closest() to find the correct button/form.
            if (container) {
                container.addEventListener('click', function(e) {

                    // Use closest() to check if the clicked element is a love-btn
                    const button = e.target.closest('.love-btn');

                    // --- 1. WISHLIST / LOVE BUTTON LOGIC ---
                    if (button) {
                        e.preventDefault(); // Stop the form submission

                        const form = button.closest('.love-form');

                        if (!form) return; // Should not happen, but safe guard

                        const cardId = form.dataset.id;
                        const tokenInput = form.querySelector('input[name="__RequestVerificationToken"]');

                        if (!tokenInput) {
                            console.error("Anti-forgery token not found in love-form.");
                            return;
                        }

                        const token = tokenInput.value;

                        // Add a temporary loading/disabled state to prevent double-click
                        button.disabled = true;

                        fetch(`/Home/Love/${cardId}`, {
                            method: 'POST',
                            headers: {
                                'RequestVerificationToken': token,
                                'Content-Type': 'application/json'
                            }
                        })
                        .then(response => {
                            button.disabled = false; // Re-enable button
                            if (response.ok) {
                                return response.json();
                            } else if (response.status === 401) {
                                alert("Please log in to like this item.");
                                throw new Error('Unauthorized'); // Stop further processing
                            } else {
                                throw new Error(`Server responded with status: ${response.status}`);
                            }
                        })
                        .then(data => {
                            if (data && data.liked) {
                                // Successful Like
                                button.classList.add('liked');
                                button.title = "Unlike";
                            } else if (data && data.liked === false) {
                                // Successful Unlike
                                button.classList.remove('liked');
                                button.title = "Like";
                            }
                        })
                        .catch(error => {
                            console.error('AJAX Error:', error);
                            // Only show a generic alert if it wasn't the 401 error
                            if (error.message !== 'Unauthorized') {
                                alert(`Error processing request: ${error.message}`);
                            }
                        });
                    }

                    // --- 2. ADD TO CART BUTTON LOGIC ---
                    // This section should also be updated to listen for a click event,
                    // but since the original was hidden, you may address this later
                    /*
                    const cartButton = e.target.closest('.cart-form button'); // Assuming a button inside a cart-form
                    if (cartButton && cartButton.closest('.cart-form')) {
                         e.preventDefault();
                         // Your original cart logic here...
                    }
                    */

                }); // End of click event listener
            } // End of if(container)

        }); // End of DOMContentLoaded
    </script>
}