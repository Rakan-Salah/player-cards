@using System.Globalization
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<PlayerCards.Languages.SharedResource> T
@using System.Security.Claims
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PlayerCards</title>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PlayerCards.styles.css" asp-append-version="true" />

    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
</head>
<body>

    @{
        // Determine if the user is a SuperAdmin
        bool isSuperAdmin = Context.User.Identity.IsAuthenticated && Context.User.IsInRole("SuperAdmin");

        // Check if the current view is one of the "e-commerce" product/list views
        string controller = ViewContext.RouteData.Values["controller"]?.ToString();
        string action = ViewContext.RouteData.Values["action"]?.ToString();

        bool isEcommerceView =
        controller == "Home" &&
        (action == "Index" || action == "Liked" || action == "Cart");

        // The Bootstrap header is only shown if SuperAdmin (for admin functions)
        // OR if it's a non-e-commerce page (e.g., Privacy, Login, etc.)
        bool showBootstrapHeader = isSuperAdmin || !isEcommerceView;
    }

    @if (showBootstrapHeader)
    {
        <header>
            <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
                <div class="container-fluid">
                    <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">PlayerCards</a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                            aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                        <ul class="navbar-nav flex-grow-1">
                            @if (User.Identity.IsAuthenticated)
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                                </li>
                            }
                        </ul>

                        @{
                            var userRole = Context.User.FindFirst(ClaimTypes.Role)?.Value;
                        }

                        <form asp-controller="Language" asp-action="SetLanguage" method="post" class="d-flex align-items-center me-3">
                            <select name="culture" class="form-select form-select-sm w-auto" onchange="this.form.submit()">
                                <option value="en" selected="@(CultureInfo.CurrentUICulture.Name.StartsWith("en") ? "selected" : null)">English</option>
                                <option value="ar" selected="@(CultureInfo.CurrentUICulture.Name.StartsWith("ar") ? "selected" : null)">العربية</option>
                            </select>
                            <input type="hidden" name="returnUrl" value="@($"{Context.Request.Path}{Context.Request.QueryString}")" />
                        </form>

                        <ul class="navbar-nav">
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                // Show SuperAdmin link only if SuperAdmin
                                if (userRole == "SuperAdmin")
                                {
                                    <li class="nav-item">
                                        <a class="nav-link text-dark" asp-controller="SuperAdmin" asp-action="Dashboard">@T["ManageUsers"]</a>
                                    </li>
                                }
                                // The User links are generally managed by the new e-commerce header in index.cshtml
                            }
                        </ul>

                        @await Html.PartialAsync("_LoginPartial")
                    </div>
                </div>
            </nav>
        </header>
    }

    <div class="@(showBootstrapHeader ? "container" : "")">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)


    <script>
        /**
         * Scrolls the featured product carousel left or right by the width of one card.
         * param {number} direction - 1 for next (right), -1 for previous (left).
         */
        function scrollCarousel(direction) {
            const carousel = document.getElementById('featuredCarousel');

            if (carousel) {
                // Get the width of a single card + its right margin/gap
                // The card is ~25% wide, but we calculate the exact distance using the first card
                const firstCard = carousel.querySelector('.player-card');

                // Fallback: If no cards, scroll 25% of container width (which is 1/4th)
                let scrollAmount = carousel.clientWidth / 4;

                if (firstCard) {
                     // Get the actual outer width (content + padding + border + margin/gap)
                     const cardWidth = firstCard.offsetWidth;
                     const gap = 30; // Defined in .card-carousel CSS
                     scrollAmount = cardWidth + gap;
                }

                // Calculate the new scroll position
                const newScrollLeft = carousel.scrollLeft + (direction * scrollAmount);

                // Perform the scroll
                carousel.scrollTo({
                    left: newScrollLeft,
                    behavior: 'smooth'
                });
            }
        }
    </script>
</body>
</html>
